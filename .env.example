# Copy to .env (never commit .env). Shared by backend/ and translation_worker/.
# The frontend needs no secrets: it talks to the backend through the Vite proxy.

# ---------- Django ----------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# SQLite for local dev; PostgreSQL for production, e.g.
# DATABASE_URL=postgres://translator:password@localhost:5432/translator
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- LiveKit ----------
# Local dev: `tools\livekit\livekit-server.exe --dev` uses the public dev pair devkey / secret.
# For LiveKit Cloud, paste your project's URL / key / secret here.
# Development on Wi-Fi with phones: LIVEKIT_URL=auto and DJANGO_ALLOWED_HOSTS=* (DEBUG only) follow the PC's address.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=replace-me
# Optional: URL the worker uses (e.g. ws://127.0.0.1:7880 when on the same machine as LiveKit).
LIVEKIT_WORKER_URL=
LIVEKIT_TOKEN_TTL_SECONDS=600
AGENT_NAME=call-translator

# ---------- Worker <-> backend ----------
# Shared secret the worker uses to report usage to the backend's internal endpoint.
WORKER_SHARED_SECRET=replace-with-another-long-random-string
BACKEND_INTERNAL_URL=http://127.0.0.1:8000

# ---------- AI translation ----------
# Set to false to disable ALL paid AI calls (call still works, no translation).
TRANSLATION_ENABLED=true
# Live calls: sarvam (cloud, streaming) | local (free open-source models, turn by turn; see docs/LOCAL_AI.md)
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
# realtime = wss://api.sarvam.ai/speech-to-text-realtime/ws ; legacy = /speech-to-text/ws
SARVAM_STT_API=realtime
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
# rest = one REST call per sentence (WAV, documented) ; stream = TTS WebSocket (MP3 chunks)
SARVAM_TTS_MODE=rest
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_DEFAULT_SPEAKER=shubh
PROVIDER_TIMEOUT_SECONDS=10

# ---------- Cost controls ----------
MAX_CALL_DURATION_SECONDS=600
# Video calls use only LiveKit bandwidth (~0.5–1 Mbps per person at 360p), no extra AI cost.
VIDEO_CALLS_ENABLED=true
MAX_PARTICIPANTS=2
DAILY_CALL_SECONDS_LIMIT=3600
DAILY_STT_SECONDS_LIMIT=1800
DAILY_TTS_CHARS_LIMIT=20000
DAILY_TRANSLATE_CHARS_LIMIT=40000
PER_CALL_STT_SECONDS_LIMIT=600
PER_CALL_TTS_CHARS_LIMIT=6000
PER_CALL_TRANSLATE_CHARS_LIMIT=12000
ROOM_CREATE_RATE=10/hour
TOKEN_RATE=30/hour

# ---------- Worker behaviour ----------
# Stop playing a translation to someone as soon as they start talking (loses the rest of that sentence's audio).
INTERRUPT_ON_LISTENER_SPEECH=false
# Do not stream silence to the paid STT API (local energy gate).
LOCAL_SPEECH_GATE=true
LOCAL_SPEECH_GATE_DBFS=-45
MAX_PENDING_UTTERANCES=2
USAGE_REPORT_INTERVAL_SECONDS=15

# ---------- Mobile app / phone login ----------
# console = OTP codes printed to the backend log (DJANGO_DEBUG=true only). A DLT-registered SMS provider is
# required for real users.
SMS_BACKEND=console
OTP_RATE=10/hour
# Virtual number users forward their calls to (set once the telephony provider is configured).
PHONE_FORWARDING_NUMBER=
# Language assumed for phone callers until their language is detected.
PHONE_DEFAULT_LANGUAGE=hi-IN
PHONE_ANNOUNCEMENT=true

# ---------- Phone calls through LiveKit SIP (docs/TELEPHONY.md) ----------
# Keep false until the SIP trunk (Exotel / Plivo) and the LiveKit SIP service are running.
TELEPHONY_ENABLED=false
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=
PHONE_RING_SECONDS=30
PHONE_DIAL_ALLOWED_PREFIXES=+91
PHONE_DIAL_DAILY_LIMIT_PER_USER=20
DIAL_RATE=20/hour
PHONE_ROOM_PREFIX=phone-
PHONE_FORWARDED_FROM_ATTRIBUTE=forwarded_from
# Used once by `python backend/manage.py setup_sip` to create the LiveKit trunks + dispatch rule:
SIP_INBOUND_NUMBERS=
SIP_PROVIDER_ADDRESSES=
SIP_FORWARDED_FROM_HEADER=
SIP_OUTBOUND_ADDRESS=
SIP_OUTBOUND_NUMBER=
SIP_OUTBOUND_USERNAME=
SIP_OUTBOUND_PASSWORD=

# ---------- Docker deployment (deploy/docker-compose.yml) ----------
APP_DOMAIN=
POSTGRES_PASSWORD=

# ---------- Meetings (recording, transcripts, AI notes) ----------
# Private storage for recordings (never served as static files).
MEDIA_ROOT=
MEETING_MAX_UPLOAD_MB=200
MEETING_MAX_DURATION_SECONDS=7200
# sarvam = cloud (≈ ₹30 per hour of audio) | local = faster-whisper (free; via the local AI service, or in-process
# with pip install -r backend/requirements-local-stt.txt)
MEETING_STT_ENGINE=sarvam
MEETING_STT_MODEL=saaras:v4
# codemix keeps English words inside Tamil/Hindi speech
MEETING_STT_MODE=codemix
MEETING_TRANSLATE_MODEL=mayura:v1
LOCAL_WHISPER_MODEL=small
SARVAM_MIN_REQUEST_INTERVAL=1.05
# AI meeting notes: anthropic | ollama (free, local) | none. Leave ANTHROPIC_API_KEY empty to disable (no charges).
SUMMARY_PROVIDER=anthropic
SUMMARY_MODEL=claude-opus-5-5
SUMMARY_EFFORT=medium
ANTHROPIC_API_KEY=
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b

# ---------- Free local AI service (docs/LOCAL_AI.md) ----------
# Start: .venv-localai\Scripts\python -m local_ai.server   (own virtualenv, Python 3.12)
LOCAL_AI_URL=
LOCAL_AI_SECRET=
# Engine per job in the apps: sarvam | local. AI_ENGINE sets all three.
AI_ENGINE=sarvam
# TRANSLATE_ENGINE=local
# STT_ENGINE=local
# TTS_ENGINE=local
LOCAL_AI_MEMORY_BUDGET_GB=5.5
LOCAL_MT_INDIC_INDIC_MODE=direct
LOCAL_MT_BEAMS=1
LOCAL_WHISPER_FAST_MODEL=base
LOCAL_TTS_DTYPE=float32
LOCAL_TTS_LANGUAGES=ta,hi,en
# Encrypts API keys saved from the web admin page (Admin → API keys). Required in production. Generate with:
#   .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_ENCRYPTION_KEY=
# Generate notes automatically after every transcription (off = only when the user clicks)
MEETING_AUTO_SUMMARY=false

# ---------- Instant / face-to-face translation (mobile) ----------
# Uses SARVAM_TTS_MODEL / SARVAM_TTS_SAMPLE_RATE above. Counted in the DAILY_* limits.
QUICK_MAX_SPEECH_SECONDS=30
QUICK_MAX_UPLOAD_KB=2048
QUICK_MAX_TEXT_CHARS=1000
QUICK_RATE=120/hour

# ---------- AI assistant + photo translation (mobile, uses ANTHROPIC_API_KEY) ----------
# Opus 5.5 at low effort: roughly Rs 1 per chat reply, Rs 2-3 per photo. claude-haiku-5-5 is cheaper.
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_EFFORT=low
ASSISTANT_DAILY_REQUESTS_PER_USER=100
ASSISTANT_DAILY_REQUESTS=500
ASSISTANT_RATE=60/hour

# ---------- Plans and admin dashboard ----------
# Per-user limits come from plans (Admin → Plans). Administrators are not limited.
# Make your account an admin (after signing in once):  python backend/manage.py grant_admin --phone +91XXXXXXXXXX
PLANS_ENFORCED=true
# Cost estimates on the dashboard (INR / USD). Check them against your invoices.
COST_SARVAM_STT_INR_PER_HOUR=30
COST_SARVAM_TRANSLATE_INR_PER_10K_CHARS=20
COST_SARVAM_TTS_INR_PER_10K_CHARS=30
COST_CLAUDE_INPUT_USD_PER_MTOK=4
COST_CLAUDE_OUTPUT_USD_PER_MTOK=20
COST_USD_TO_INR=88
