# Production settings for your own Ubuntu server (deploy/SELF_HOSTED.md).
# Don't edit secrets by hand: on the server run   bash deploy/make-env.sh app.yourdomain.in
# It copies this file to .env, puts a new random secret in every random placeholder and fills in the domains.
# Then set the values it lists as still to fill (LiveKit Cloud and the Hugging Face token).

# ---------- Django ----------
DJANGO_SECRET_KEY=__RANDOM__
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=__APP_DOMAIN__,backend
CORS_ALLOWED_ORIGINS=https://__APP_DOMAIN__
CSRF_TRUSTED_ORIGINS=https://__APP_DOMAIN__
# DATABASE_URL, MEDIA_ROOT and BACKEND_INTERNAL_URL are set by docker-compose.yml.
SECRETS_ENCRYPTION_KEY=__FERNET__

# ---------- Domain ----------
APP_DOMAIN=__APP_DOMAIN__
POSTGRES_PASSWORD=__RANDOM__

# ---------- LiveKit Cloud (cloud.livekit.io -> your project -> Settings -> API keys) ----------
# URL looks like wss://asta-ai-xxxxxxxx.livekit.cloud . Keep the secret only in this file.
LIVEKIT_URL=__FILL__
LIVEKIT_API_KEY=__FILL__
LIVEKIT_API_SECRET=__FILL__
LIVEKIT_TOKEN_TTL_SECONDS=600
AGENT_NAME=call-translator
WORKER_SHARED_SECRET=__RANDOM__

# ---------- Free local AI (deploy/docker-compose.selfhosted.yml) ----------
LOCAL_AI_SECRET=__RANDOM__
# Hugging Face read token (gated AI4Bharat models; see docs/LOCAL_AI.md step 2)
HF_TOKEN=__FILL__
AI_ENGINE=local
MEETING_STT_ENGINE=local
SUMMARY_PROVIDER=ollama
OLLAMA_MODEL=qwen3:30b-instruct
ASSISTANT_PROVIDER=ollama
ASSISTANT_OLLAMA_MODEL=qwen3:30b-instruct
ASSISTANT_VISION_MODEL=qwen3-vl:8b-instruct
OLLAMA_TIMEOUT_SECONDS=600
LOCAL_AI_TIMEOUT_SECONDS=300
LOCAL_AI_MEMORY_BUDGET_GB=24
LOCAL_AI_TORCH_THREADS=16
LOCAL_WHISPER_THREADS=8
LOCAL_WHISPER_MODEL=large-v3-turbo
LOCAL_WHISPER_FAST_MODEL=small
LOCAL_MT_INDIC_INDIC_MODE=direct
LOCAL_MT_BEAMS=2
LOCAL_TTS_DTYPE=float32
LOCAL_TTS_LANGUAGES=ta,hi,en

# ---------- Live calls ----------
# sarvam = real-time (needs SARVAM_API_KEY, or add it on Admin -> API keys). local = free, turn by turn.
SPEECH_PROVIDER=sarvam
SARVAM_API_KEY=
TRANSLATION_ENABLED=true
SARVAM_STT_API=realtime
SARVAM_STT_MODEL=saaras:v3-realtime
SARVAM_TRANSLATE_MODEL=mayura:v1
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_MODE=rest
SARVAM_TTS_SAMPLE_RATE=24000
SARVAM_DEFAULT_SPEAKER=shubh
PROVIDER_TIMEOUT_SECONDS=10

# ---------- Cloud AI (optional; leave empty for free local AI only) ----------
ANTHROPIC_API_KEY=

# ---------- Limits ----------
MAX_CALL_DURATION_SECONDS=600
VIDEO_CALLS_ENABLED=true
MAX_PARTICIPANTS=2
DAILY_CALL_SECONDS_LIMIT=36000
DAILY_STT_SECONDS_LIMIT=1800
DAILY_TTS_CHARS_LIMIT=20000
DAILY_TRANSLATE_CHARS_LIMIT=40000
ROOM_CREATE_RATE=10/hour
TOKEN_RATE=30/hour
PLANS_ENFORCED=true
ASSISTANT_DAILY_REQUESTS_PER_USER=100
ASSISTANT_DAILY_REQUESTS=500
MEETING_MAX_UPLOAD_MB=200
MEETING_MAX_DURATION_SECONDS=7200
MEETING_AUTO_SUMMARY=false

# ---------- Phone login and phone calls (later) ----------
# disabled until a DLT-registered SMS provider is connected; sign in with username + password meanwhile.
SMS_BACKEND=disabled
TELEPHONY_ENABLED=false
PHONE_DEFAULT_LANGUAGE=hi-IN
PHONE_ANNOUNCEMENT=true
