{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "livekit",
      "runtimeExecutable": "tools/livekit/livekit-server.exe",
      "runtimeArgs": [
        "--dev",
        "--bind",
        "0.0.0.0"
      ],
      "port": 7880
    },
    {
      "name": "backend",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": [
        "backend/manage.py",
        "runserver",
        "0.0.0.0:8010",
        "--noreload"
      ],
      "port": 8010
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "local-ai",
      "runtimeExecutable": ".venv-localai/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "local_ai.server"
      ],
      "port": 8090
    }
  ]
}
